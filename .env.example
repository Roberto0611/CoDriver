# ==============================================================================
# TigerData (TimescaleDB / PostgreSQL) - Plantilla de Configuración
# ==============================================================================
# Copia este archivo a .env y ajusta las credenciales según tu entorno.
#
# 1. Local (Docker):
# TIGERDATA_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
#
# 2. Cloud (TigerData / Timescale Cloud):
# TIGERDATA_DATABASE_URL=postgresql://<usuario>:<password>@<host>:5432/<dbname>?sslmode=require
# También se aceptan las variables estándar PGHOST, PGPORT, PGDATABASE, PGUSER,
# PGPASSWORD y PGSSLMODE que descarga TigerData Cloud; no hace falta armar la URL.
# ==============================================================================
TIGERDATA_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Voz de Nuez (ElevenLabs). La llave nunca sale del backend.
ELEVENLABS_API_KEY=
# Opcionales; ver voz/config.py para las voces que suenan a Nuez.
NUEZ_VOICE_ID=cgSgspJ2msm6clMCkdW9
NUEZ_TTS_MODEL=eleven_flash_v2_5

# Telemetría de Gemini para el pitch. Copiar las tarifas vigentes del modelo usado
# (USD por 1M tokens) y el tipo de cambio del día. Vacío = se reportan llamadas y
# tokens reales, pero nunca se inventa un costo.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
USD_TO_MXN=
